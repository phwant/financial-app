  <script>
    // DEMONSTRATION DATA + IN-MEMORY OPERATIONS. No production data access is implemented.
    const DEMO_NOW=new Date(2025,5,1);
    const seed=[
      {name:"Monthly salary",type:"Income",subtype:"",amount:82500,day:28,icon:"briefcase-business"},
      {name:"Freelance project",type:"Income",subtype:"",amount:12600,day:19,icon:"laptop"},
      {name:"Apartment rent",type:"Expense",subtype:"Fixed",amount:21500,day:3,icon:"house"},
      {name:"Groceries",type:"Expense",subtype:"Variable",amount:6840,day:21,icon:"shopping-basket"},
      {name:"Dining & coffee",type:"Expense",subtype:"Variable",amount:3850,day:16,icon:"coffee"},
      {name:"Utilities",type:"Expense",subtype:"Fixed",amount:2980,day:11,icon:"zap"},
      {name:"Transport",type:"Expense",subtype:"Variable",amount:2460,day:13,icon:"train-front"},
      {name:"Subscriptions",type:"Expense",subtype:"Fixed",amount:1190,day:7,icon:"play"},
      {name:"Tax withholding",type:"Deduction",subtype:"",amount:7550,day:28,icon:"receipt"},
      {name:"Insurance",type:"Deduction",subtype:"",amount:2150,day:5,icon:"shield-check"}
    ];
    let nextId=1;
    let entries=[];
    for(let offset=-5;offset<=2;offset++){
      const d=new Date(DEMO_NOW.getFullYear(),DEMO_NOW.getMonth()+offset,1),factor=1+offset*.018;
      seed.forEach((item,i)=>entries.push({...item,id:nextId++,year:d.getFullYear(),month:d.getMonth(),amount:Math.round(item.amount*factor/10)*10,day:Math.min(item.day,new Date(d.getFullYear(),d.getMonth()+1,0).getDate()),demo:true}));
    }
    let viewDate=new Date(DEMO_NOW),screen="overview",filter="All",subfilter="All",selectionMode=false,selected=new Set(),editingId=null,bubbleChart=null,yearChart=null,toastTimer;
    const $=id=>document.getElementById(id);
    const money=n=>"฿"+Math.round(n).toLocaleString("en-US");
    const shortMoney=n=>"฿"+(Math.abs(n)>=1000?(n/1000).toFixed(n%1000===0?0:1)+"k":Math.round(n));
    const monthLabel=d=>new Intl.DateTimeFormat("en-US",{month:"long",year:"numeric"}).format(d);
    const monthShort=d=>new Intl.DateTimeFormat("en-US",{month:"short"}).format(d);
    const forPeriod=d=>entries.filter(e=>e.year===d.getFullYear()&&e.month===d.getMonth()).sort((a,b)=>b.day-a.day||b.id-a.id);
    const totals=d=>{const list=forPeriod(d),sum=type=>list.filter(e=>e.type===type).reduce((n,e)=>n+e.amount,0);let income=sum("Income"),expense=sum("Expense"),deduction=sum("Deduction");return {income,expense,deduction,balance:income-expense-deduction}};
    const shift=(d,n)=>new Date(d.getFullYear(),d.getMonth()+n,1);
    const pct=(value,previous)=>previous?((value-previous)/Math.abs(previous)*100):0;
    const delta=(value,previous)=>`${pct(value,previous)>=0?"+":""}${pct(value,previous).toFixed(1)}% vs previous month`;
    const safe=s=>String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
    function notify(text){const el=$("toast");el.textContent=text;el.classList.add("show");clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove("show"),2800)}
    function icons(){if(window.lucide)lucide.createIcons()}
    function entryHTML(e,selectable=false){const isSelected=selected.has(e.id),date=new Date(e.year,e.month,e.day);return `<button class="transaction canva-card ${isSelected&&selectable?"selected":""}" type="button" data-entry="${e.id}" aria-label="${selectable?(isSelected?"Deselect":"Select"):"Edit"} ${safe(e.name)}, ${money(e.amount)}" ${selectable?`aria-pressed="${isSelected}"`:""}>${selectable?`<span class="entry-check ${isSelected?"checked":""}">${isSelected?'<i data-lucide="check"></i>':""}</span>`:""}<span class="tile ${e.type.toLowerCase()}"><i data-lucide="${e.icon}"></i></span><span class="entry-copy"><span class="entry-name canva-text">${safe(e.name)}</span><span class="entry-meta canva-text">${e.type}${e.subtype?" · "+e.subtype:""} · ${monthShort(date)} ${e.day}</span></span><span class="entry-amount canva-text">${e.type==="Income"?"+":"−"}${money(e.amount)}</span></button>`}
    function renderOverview(){const t=totals(viewDate);$("overview-period").textContent=monthLabel(viewDate);$("balance-value").textContent=money(t.balance);$("overview-metrics").innerHTML=[["Income",t.income,"arrow-down-left"],["Expense",t.expense,"arrow-up-right"],["Deduction",t.deduction,"minus"]].map(([name,value,icon])=>`<article class="metric canva-card"><div class="metric-icon"><i data-lucide="${icon}"></i></div><div class="metric-name canva-text">${name}</div><div class="metric-value canva-text">${money(value)}</div></article>`).join("");const list=forPeriod(viewDate).slice(0,6);$("highlights-list").innerHTML=list.length?list.map(e=>entryHTML(e)).join(""):'<div class="empty canva-panel">No demo entries for this month yet.</div>'}
    function visibleEntries(){return forPeriod(viewDate).filter(e=>(filter==="All"||e.type===filter)&&(filter!=="Expense"||subfilter==="All"||e.subtype===subfilter))}
    function renderEntries(){ $("entries-period").textContent=monthLabel(viewDate);$("entry-filters").innerHTML=["All","Income","Expense","Deduction"].map(x=>`<button type="button" class="segment canva-button ${filter===x?"active":""}" data-filter="${x}" aria-pressed="${filter===x}">${x}</button>`).join("");$("expense-subfilters").style.display=filter==="Expense"?"flex":"none";$("expense-subfilters").innerHTML=["All","Fixed","Variable"].map(x=>`<button type="button" class="subfilter canva-button ${subfilter===x?"active":""}" data-subfilter="${x}" aria-pressed="${subfilter===x}">${x}</button>`).join("");$("select-toggle").textContent=selectionMode?"Done":"Select";$("bulkbar").classList.toggle("visible",selectionMode);$("selected-count").textContent=`${selected.size} selected`;$("delete-selected").disabled=!selected.size;const list=visibleEntries();$("entry-count").textContent=`${list.length} ${list.length===1?"entry":"entries"}`;$("entry-total").textContent=`Total ${money(list.reduce((n,e)=>n+e.amount,0))}`;$("entries-list").innerHTML=list.length?list.map(e=>entryHTML(e,selectionMode)).join(""):'<div class="empty canva-panel">No entries match this view.<br>Try another filter or month.</div>'}
    const chartInk="#0B0D0E";
    function chartDefaults(){Chart.defaults.color=chartInk;Chart.defaults.font.family='"Inter", "Noto Sans Thai", sans-serif';Chart.defaults.font.size=10}
    function renderInsights(){const t=totals(viewDate),prior=totals(shift(viewDate,-1));$("insights-period").textContent=monthLabel(viewDate);$("insight-balance").textContent=money(t.balance);$("balance-delta").textContent=delta(t.balance,prior.balance);$("summary-grid").innerHTML=[["Income",t.income,prior.income],["Expense",t.expense,prior.expense],["Deduction",t.deduction,prior.deduction]].map(([name,value,previous])=>`<article class="summary-card canva-card"><div class="mini-label canva-text">${name}</div><div class="summary-number canva-text">${money(value)}</div><div class="summary-delta canva-text">${delta(value,previous)}</div></article>`).join("")+`<article class="summary-card wide canva-card"><div><div class="mini-label canva-text">Remaining Rate</div><div class="summary-delta canva-text">${delta(t.income?t.balance/t.income:0,prior.income?prior.balance/prior.income:0)}</div></div><div class="summary-number canva-text">${t.income?Math.round(t.balance/t.income*100):0}%</div></article>`;const expense=forPeriod(viewDate).filter(e=>e.type==="Expense"),fixed=expense.filter(e=>e.subtype==="Fixed").reduce((n,e)=>n+e.amount,0),variable=expense.filter(e=>e.subtype==="Variable").reduce((n,e)=>n+e.amount,0);$("fixed-bar").style.width=`${t.expense?fixed/t.expense*100:0}%`;$("variable-bar").style.width=`${t.expense?variable/t.expense*100:0}%`;$("fixed-value").textContent=money(fixed);$("variable-value").textContent=money(variable);
      const months=Array.from({length:6},(_,i)=>shift(viewDate,i-5));$("monthly-table").innerHTML=months.slice().reverse().map(d=>{const a=totals(d);return `<tr><td>${monthShort(d)} ${d.getFullYear()}</td><td>${money(a.income)}</td><td>${money(a.expense)}</td><td>${money(a.deduction)}</td><td>${money(a.balance)}</td></tr>`}).join("");
      const years=Array.from({length:4},(_,i)=>viewDate.getFullYear()-i);$("annual-table").innerHTML=years.map(y=>{let a={income:0,expense:0,deduction:0,balance:0};for(let m=0;m<12;m++){let v=totals(new Date(y,m,1));Object.keys(a).forEach(k=>a[k]+=v[k])}return `<tr><td>${y}</td><td>${money(a.income)}</td><td>${money(a.expense)}</td><td>${money(a.deduction)}</td><td>${money(a.balance)}</td></tr>`}).join("");
      const ranked=expense.slice().sort((a,b)=>b.amount-a.amount).slice(0,3);$("top-spending").innerHTML=ranked.length?ranked.map((e,i)=>`<div class="rank-row"><span class="rank-num">0${i+1}</span><span class="tile ${e.type.toLowerCase()}" style="width:34px;height:34px;flex-basis:34px;border-radius:11px"><i data-lucide="${e.icon}"></i></span><span class="rank-name canva-text">${safe(e.name)}</span><span class="rank-amount canva-text">${money(e.amount)}</span></div>`).join(""):'<div class="empty">No spending in this period.</div>';icons();requestAnimationFrame(()=>drawCharts(months))}
    function drawCharts(months){if(screen!=="insights"||!window.Chart)return;chartDefaults();if(bubbleChart)bubbleChart.destroy();if(yearChart)yearChart.destroy();const values=months.map(d=>totals(d).expense);bubbleChart=new Chart($("bubble-chart"),{type:"bubble",data:{datasets:[{label:"Monthly expense",data:months.map((d,i)=>({x:i+1,y:values[i],r:Math.max(8,Math.min(21,values[i]/1900))})),backgroundColor:"rgba(113,155,178,.73)",borderColor:"#527f97",borderWidth:1.5,hoverBackgroundColor:"#8cb2c7"}]},options:{responsive:true,maintainAspectRatio:false,onClick:(_,points)=>{if(points.length){let i=points[0].index;$("bubble-detail").textContent=`${monthLabel(months[i])} · Expenses ${money(values[i])}`}},plugins:{legend:{display:false},tooltip:{callbacks:{title:items=>monthLabel(months[items[0].dataIndex]),label:item=>`Expense ${money(item.raw.y)}`}}},scales:{x:{min:.5,max:6.5,ticks:{stepSize:1,callback:v=>months[v-1]?monthShort(months[v-1]):""},grid:{display:false}},y:{beginAtZero:true,ticks:{callback:v=>shortMoney(v),maxTicksLimit:5},grid:{color:"rgba(46,91,106,.1)"}}}}});
      const yr=viewDate.getFullYear(),labels=Array.from({length:6},(_,i)=>yr-5+i),yearValues=labels.map((y,i)=>{let actual=0;for(let m=0;m<12;m++)actual+=totals(new Date(y,m,1)).balance;return actual||Math.round((250000+i*38500)*(i%2?.96:1.04))});yearChart=new Chart($("year-chart"),{type:"line",data:{labels,datasets:[{data:yearValues,borderColor:"#719bb2",backgroundColor:"rgba(113,155,178,.1)",borderWidth:2.5,pointRadius:5,pointHoverRadius:7,pointBackgroundColor:"#719bb2",pointBorderColor:"#dceef0",pointBorderWidth:2,tension:.34,fill:true}]},options:{responsive:true,maintainAspectRatio:false,onClick:(_,points)=>{if(points.length){let i=points[0].index;$("year-detail").textContent=`${labels[i]} · Annual balance ${money(yearValues[i])}${labels[i]===yr?" (available demo months)":""}`}},plugins:{legend:{display:false},tooltip:{callbacks:{label:item=>`Balance ${money(item.raw)}`}}},scales:{x:{grid:{display:false}},y:{beginAtZero:true,ticks:{callback:v=>shortMoney(v),maxTicksLimit:5},grid:{color:"rgba(46,91,106,.1)"}}}}})}
    function render(){document.querySelectorAll(".screen").forEach(el=>el.classList.toggle("active",el.id===screen+"-screen"));$("screen-title").textContent=screen[0].toUpperCase()+screen.slice(1);document.querySelectorAll(".nav-item").forEach(el=>{const active=el.dataset.screen===screen;el.classList.toggle("active",active);if(active)el.setAttribute("aria-current","page");else el.removeAttribute("aria-current")});$("add-button").style.display=screen==="insights"?"none":"grid";renderOverview();renderEntries();if(screen==="insights")renderInsights();icons()}
    function navigate(to){screen=to;render();window.scrollTo({top:0,behavior:"smooth"})}
    function openModal(title,body){$("modal-title").textContent=title;$("modal-body").innerHTML=body;$("modal-backdrop").classList.add("open");$("modal-backdrop").setAttribute("aria-hidden","false");document.body.style.overflow="hidden";icons();$("modal-close").focus()}
    function closeModal(){$("modal-backdrop").classList.remove("open");$("modal-backdrop").setAttribute("aria-hidden","true");document.body.style.overflow=""}
    function openPeriod(){openModal("Choose period",`<form id="period-form"><p class="modal-note">Explore different months of demonstration data.</p><div class="field-row"><div class="field"><label for="choose-month">Month</label><select id="choose-month" class="canva-input">${Array.from({length:12},(_,m)=>`<option value="${m}" ${m===viewDate.getMonth()?"selected":""}>${new Intl.DateTimeFormat("en-US",{month:"long"}).format(new Date(2025,m,1))}</option>`).join("")}</select></div><div class="field"><label for="choose-year">Year</label><select id="choose-year" class="canva-input">${Array.from({length:7},(_,i)=>2023+i).map(y=>`<option value="${y}" ${y===viewDate.getFullYear()?"selected":""}>${y}</option>`).join("")}</select></div></div><button class="primary-btn canva-button" type="submit">Apply period</button></form>`)}
    function openEntry(id=null){editingId=id;let e=id?entries.find(x=>x.id===id):null;openModal(e?"Edit entry":"Add entry",`<form id="entry-form"><p class="modal-note">Demo only — changes are visible in this session.</p><div class="field"><label for="entry-name">Entry name</label><input class="canva-input" id="entry-name" maxlength="48" required placeholder="e.g. Groceries" value="${e?safe(e.name):""}"></div><div class="field-row"><div class="field"><label for="entry-amount">Amount (฿)</label><input class="canva-input" id="entry-amount" type="number" min="0.01" step="0.01" required placeholder="0.00" value="${e?e.amount:""}"></div><div class="field"><label for="entry-day">Day of month</label><input class="canva-input" id="entry-day" type="number" min="1" max="${new Date(viewDate.getFullYear(),viewDate.getMonth()+1,0).getDate()}" required value="${e?e.day:Math.min(15,new Date(viewDate.getFullYear(),viewDate.getMonth()+1,0).getDate())}"></div></div><div class="field-row"><div class="field"><label for="entry-type">Type</label><select class="canva-input" id="entry-type">${["Income","Expense","Deduction"].map(x=>`<option ${e?.type===x?"selected":""}>${x}</option>`).join("")}</select></div><div class="field" id="subtype-field"><label for="entry-subtype">Expense type</label><select class="canva-input" id="entry-subtype"><option ${e?.subtype==="Variable"?"selected":""}>Variable</option><option ${e?.subtype==="Fixed"?"selected":""}>Fixed</option></select></div></div><button class="primary-btn canva-button" type="submit">${e?"Save changes":"Add demo entry"}</button></form>`);$("subtype-field").style.display=$("entry-type").value==="Expense"?"grid":"none"}
    function openCopy(){const previous=shift(viewDate,-1),items=forPeriod(previous);openModal("Copy previous month",`<p class="modal-note">Select demo entries from ${monthLabel(previous)} to add to ${monthLabel(viewDate)}. Dates and amounts can be edited afterward.</p><div class="modal-list">${items.length?items.map(e=>`<label class="copy-option"><input type="checkbox" class="copy-check" value="${e.id}" checked><span>${safe(e.name)}</span><strong>${money(e.amount)}</strong></label>`).join(""):'<div class="empty">No entries in the previous month.</div>'}</div><button id="copy-confirm" class="primary-btn canva-button" type="button" ${items.length?"":"disabled"}>Copy selected entries</button>`)}
    document.addEventListener("click",event=>{const nav=event.target.closest("[data-screen]");if(nav){navigate(nav.dataset.screen);return}const step=event.target.closest("[data-period]");if(step){viewDate=shift(viewDate,Number(step.dataset.period));render();return}const f=event.target.closest("[data-filter]");if(f){filter=f.dataset.filter;subfilter="All";selected.clear();renderEntries();return}const sf=event.target.closest("[data-subfilter]");if(sf){subfilter=sf.dataset.subfilter;selected.clear();renderEntries();return}const row=event.target.closest("[data-entry]");if(row){const id=Number(row.dataset.entry);if(selectionMode&&screen==="entries"){selected.has(id)?selected.delete(id):selected.add(id);renderEntries();icons()}else openEntry(id);return}const comparison=event.target.closest("[data-comparison]");if(comparison){document.querySelectorAll("[data-comparison]").forEach(b=>b.classList.toggle("active",b===comparison));$("monthly-comparison").hidden=comparison.dataset.comparison!=="monthly";$("annual-comparison").hidden=comparison.dataset.comparison!=="annual";return}});
    $("profile-button").onclick=()=>openModal("About this prototype",'<p class="modal-note">This is a visual and interaction prototype using demonstration data only. It is not connected to real accounts or financial records. ข้อมูลทั้งหมดเป็นข้อมูลตัวอย่าง</p><button class="primary-btn canva-button" type="button" id="about-close">Got it</button>');
    $("period-picker").onclick=openPeriod;$("insights-period-button").onclick=openPeriod;$("reset-period").onclick=()=>{viewDate=new Date(DEMO_NOW);render();notify("Returned to demo month")};
    $("see-all").onclick=()=>{filter="All";subfilter="All";navigate("entries")};$("view-all-spending").onclick=()=>{filter="Expense";subfilter="All";navigate("entries")};$("add-button").onclick=()=>openEntry();$("copy-open").onclick=openCopy;
    $("select-toggle").onclick=()=>{selectionMode=!selectionMode;selected.clear();renderEntries();icons()};
    $("select-all").onclick=()=>{visibleEntries().forEach(e=>selected.add(e.id));renderEntries();icons()};
    $("delete-selected").onclick=()=>{if(!selected.size)return;openModal("Delete selected entries?",`<p class="modal-note">Remove ${selected.size} selected demo ${selected.size===1?"entry":"entries"} from this session? This cannot be undone in the current session.</p><div class="field-row"><button id="cancel-delete" class="small-btn canva-button" type="button">Cancel</button><button id="confirm-delete" class="small-btn emphasis canva-button" type="button">Delete ${selected.size}</button></div>`)};
    $("modal-close").onclick=closeModal;$("modal-backdrop").addEventListener("click",e=>{if(e.target===$("modal-backdrop"))closeModal()});
    document.addEventListener("keydown",e=>{if(e.key==="Escape"&&$("modal-backdrop").classList.contains("open"))closeModal()});
    $("modal-body").addEventListener("change",e=>{if(e.target.id==="entry-type")$("subtype-field").style.display=e.target.value==="Expense"?"grid":"none"});
    $("modal-body").addEventListener("click",e=>{if(e.target.id==="about-close"||e.target.id==="cancel-delete"){closeModal()}if(e.target.id==="confirm-delete"){entries=entries.filter(x=>!selected.has(x.id));selected.clear();selectionMode=false;closeModal();render();notify("Demo entries deleted")}if(e.target.id==="copy-confirm"){const ids=[...document.querySelectorAll(".copy-check:checked")].map(x=>Number(x.value));if(!ids.length){notify("Select at least one entry");return}ids.forEach(id=>{let source=entries.find(x=>x.id===id);if(source)entries.push({...source,id:nextId++,year:viewDate.getFullYear(),month:viewDate.getMonth(),day:Math.min(source.day,new Date(viewDate.getFullYear(),viewDate.getMonth()+1,0).getDate())})});closeModal();render();notify(`${ids.length} demo ${ids.length===1?"entry":"entries"} copied`)}});
    $("modal-body").addEventListener("submit",e=>{e.preventDefault();if(e.target.id==="period-form"){viewDate=new Date(Number($("choose-year").value),Number($("choose-month").value),1);closeModal();render();return}if(e.target.id==="entry-form"){const name=$("entry-name").value.trim(),amount=Number($("entry-amount").value),day=Number($("entry-day").value),type=$("entry-type").value,maxDay=new Date(viewDate.getFullYear(),viewDate.getMonth()+1,0).getDate();if(!name||!Number.isFinite(amount)||amount<=0||day<1||day>maxDay){notify("Check the entry details");return}const item={name,amount,day,type,subtype:type==="Expense"?$("entry-subtype").value:"",icon:type==="Income"?"arrow-down-left":type==="Deduction"?"receipt":"shopping-bag",year:viewDate.getFullYear(),month:viewDate.getMonth(),demo:true};if(editingId){const old=entries.find(x=>x.id===editingId);if(old)Object.assign(old,item)}else entries.push({...item,id:nextId++});closeModal();render();notify(editingId?"Demo entry updated":"Demo entry added")}});
    render();
  </script>
