    function renderInsights(){const a=Finance.totals(state.period),b=Finance.totals(Finance.offset(state.period,-1));$("financial-summary").innerHTML=`<div class="summary-feature"><div><div class="caption">${t("balance")}</div><div class="big">฿${money(a.balance)}</div></div><div class="change-tag">${compareHTML(a.balance,b.balance)}</div></div><div class="summary-grid">${["income","expense","deduction"].map(k=>`<div class="summary-cell"><div class="caption">${t(k)}</div><strong>฿${money(a[k])}</strong><div class="comparison">${compareHTML(a[k],b[k])} ${t("vsPrevious")}</div></div>`).join("")}<div class="summary-cell"><div class="caption">${t("remaining")}</div><strong>${a.rate.toFixed(1)}%</strong><div class="comparison">${(a.rate-b.rate)>=0?"+":""}${(a.rate-b.rate).toFixed(1)} pp ${t("vsPrevious")}</div></div></div>`;const expenses=Finance.spending(state.period),fixed=expenses.filter(r=>r.subtype==="fixed").reduce((s,r)=>s+r.amount,0),variable=expenses.filter(r=>r.subtype==="variable").reduce((s,r)=>s+r.amount,0),total=fixed+variable;$("expense-breakdown").innerHTML=`<h3>${t("breakdown")}</h3><div class="summary-feature" style="margin-bottom:10px"><div><div class="caption">${t("expense")}</div><div class="big">฿${money(total)}</div></div></div><div class="breakdown-track canva-progress"><span style="width:${total?fixed/total*100:0}%"></span><span style="width:${total?variable/total*100:0}%"></span></div><div class="breakdown-row"><span><i class="dot"></i>${t("fixed")}</span><strong>฿${money(fixed)}</strong></div><div class="breakdown-row variable"><span><i class="dot"></i>${t("variable")}</span><strong>฿${money(variable)}</strong></div>`;$("bubble-switch").innerHTML=[6,12].map(n=>`<button type="button" data-bubble="${n}" class="${state.bubbleRange===n?"active":""}">${t(n===6?"last6":"last12")}</button>`).join("");$("line-switch").innerHTML=[6,12].map(n=>`<button type="button" data-line="${n}" class="${state.lineRange===n?"active":""}">${t(n===6?"last6":"last12")}<