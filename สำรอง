    function copyModal(){const source=Finance.offset(state.period,-1),rows=Finance.monthRecords(source);openModal(t("copyTitle"),`<p class="modal-help">${t("copyHelp")}</p><div class="modal-list">${rows.length?rows.map(r=>`<label class="copy-item"><input type="checkbox" value="${r.id}" checked><span>${esc(txName(r))}</span><strong>฿${money(r.amount)}</strong></label>`).join(""):`<div class="empty-state">${t("noneToCopy")}</div>`}</div><button id="confirm-copy" class="primary-button canva-button" type="button" ${rows.length?"":"disabled"}>${t("copySelected")}</button>`);$("confirm-copy").addEventListener("click",()=>{const ids=[...$("modal-root").querySelectorAll(".copy-item input:checked")].map(el=>Number(el.value));if(!ids.length){notify(t("chooseOne"));return}ids.forEach(id=>{const r=DemoStore.all().find(x=>x.id===id);if(r){const lastDay=new Date(Number(state.period.slice(0,4)),Number(state.period.slice(5)),0).getDate();DemoStore.add({...r,date:`${state.period}-${String(Math.min(Number(r.date.slice(-2)),lastDay)).padStart(2,"0")}`})}});closeModal();render();notify(t("copied"))})}
    function spendingModal(){const rows=Finance.spending(state.period);openModal(t("spendingTitle"),`<p class="modal-help">${periodName(state.period)} · ${rows.length} ${t("transactions")}</p><div class="modal-list">${rows.length?rows.map((r,i)=>`<div class="rank-row"><span class="rank-num">${String(i+1).padStart(2,"0")}</span><span class="rank-info"><strong>${esc(txName(r))}</strong><span>${t(r.subtype)}</span></span><strong class="rank-amount">฿${money(r.amount)}</strong></div>`).join(""):`<div class="empty-state">${t("noEntries")}</div>`}</div>`)}
    document.addEventListener("click",e=>{const nav=e.target.closest("[data-screen]");if(nav){navigate(nav.dataset.screen);return}const tx=e.target.closest("[data-tx]");if(tx){const id=Number(tx.dataset.tx);if(state.screen==="entries"&&state.bulk){state.selected.has(id)?state.selected.delete(id):state.selected.add(id);state.deleteArmed=false;renderEntries();icons()}else entryModal(id);return}const filter=e.target.closest("[data-filter]");if(filter){state.filter=filter.dataset.filter;state.subfilter="all";state.selected.clear();state.deleteArmed=false;renderEntries();return}const sub=e.target.closest("[data-subfilter]");if(sub){state.subfilter=sub.dataset.subfilter;state.selected.clear();renderEntries();return}const bubble=e.target.closest("[data-bubble]");if(bubble){state.bubbleRange=Number(bubble.dataset.bubble);renderInsights();icons();return}const line=e.target.closest("[data-line]");if(line){state.lineRange=Number(line.dataset.line);renderInsights();icons();return}if(e.target.closest("[data-close]"))closeModal();if(e.target===$("modal-root"))closeModal();if(e.target.closest("[data-select-all]")){Finance.filtered(state.period,state.filter,state.subfilter).forEach(r=>state.selected.add(r.id));renderEntries();icons()}if(e.target.closest("[data-delete]")){if(!state.deleteArmed){state.deleteArmed=true;renderEntries()}else{DemoStore.remove([...state.selected]);state.selected.clear();state.bulk=false;state.deleteArmed=false;render();notify(t("deleted"))}}});
    $("language-toggle").addEventListener("click",()=>{state.lang=state.lang==="en"?"th":"en";render()});
    $("profile-button").addEventListener("click",()=>openModal(t("overview"),`<p class="modal-help">${t("about")}</p><button type="button" class="primary-button canva-button" data-close>${t("close")}</button>`));
    $("prev-month").addEventListener("click",()=>{state.period=Finance.offset(state.period,-1);render()});
    $("next-month").addEventListener("click",()=>{state.period=Finance.offset(state.period,1);render()});
    $("reset-month").addEventListener("click",()=>{state.period=DemoStore.currentKey;render()});
    $("period-picker").addEventListener("click",periodModal);
    $("see-all").addEventListener("click",()=>navigate("entries"));
    $("view-all-spending").addEventListener("click",spendingModal);
    $("copy-month").addEventListener("click",copyModal);
    $("bulk-toggle").addEventListener("click",()=>{state.bulk=!state.bulk;state.selected.clear();state.deleteArmed=false;renderEntries();icons()});
    $("add-entry").addEventListener("click",()=>entryModal());
    document.addEventListener("keydown",e=>{if(e.key==="Escape"&&!$("modal-root").hidden)closeModal()});
    render();
  </script>
 </body>
</html>
