    function entryModal(id){const existing=DemoStore.all().find(r=>r.id===id),r=existing||{en:"",th:"",amount:"",date:state.period+"-01",type:"expense",subtype:"variable"};openModal(t(existing?"edit":"add"),`<form id="entry-form"><div class="field"><label for="entry-name">${t("name")}</label><input id="entry-name" name="name" required maxlength="60" value="${esc(txName(r))}" autocomplete="off"></div><div class="field-grid"><div class="field"><label for="entry-amount">${t("amount")} (฿)</label><input id="entry-amount" name="amount" type="number" inputmode="decimal" min="0.01" step="0.01" required value="${r.amount}"></div><div class="field"><label for="entry-date">${t("date")}</label><input id="entry-date" name="date" type="date" required value="${r.date}"></div></div><div class="field-grid"><div class="field"><label for="entry-type">${t("type")}</label><select id="entry-type" name="type">${["income","expense","deduction"].map(k=>`<option value="${k}" ${r.type===k?"selected":""}>${t(k)}</option>`).join("")}</select></div><div class="field" id="kind-field"><label for="entry-kind">${t("expenseKind")}</label><select id="entry-kind" name="subtype"><option value="variable" ${r.subtype==="variable"?"selected":""}>${t("variable")}</option><option value="fixed" ${r.subtype==="fixed"?"selected":""}>${t("fixed")}</option></select></div></div><button class="primary-button canva-button" type="submit">${t("save")}</button></form>`);$("entry-type").addEventListener("change",()=>{$("kind-field").hidden=$("entry-type").value!=="expense"});$("kind-field").hidden=r.type!=="expense";$("entry-form").addEventListener("submit",e=>{e.preventDefault();const f=new FormData(e.currentTarget),name=String(f.get("name")).trim(),amount=Number(f.get("amount")),date=String(f.get("date"));if(!name||!Number.isFinite(amount)||amount<=0||!date){notify(t("invalid"));return}const type=String(f.get("type")),subtype=type==="expense"?String(f.get("subtype")):"other",changes={en:name,th:name,amount,date,type,