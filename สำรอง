    function renderOverview(){const x=Finance.totals(state.period);$("balance-amount").innerHTML=`<span>฿</span>${money(x.balance)}`;$("overview-metrics").innerHTML=["income","expense","deduction"].map(k=>`<div><div class="metric-label canva-text">${t(k)}</div><div class="metric-value canva-text"><small>฿</small>${money(x[k])}</div></div>`).join("");const rows=Finance.monthRecords(state.period).slice(0,6);$("highlights-list").innerHTML=rows.length?rows.map(r=>transactionHTML(r)).join(""):`<div class="empty-state">${t("noEntries")}</div>`}
    function renderEntries(){const types=["all","income","expense","deduction"];$("entry-filters").innerHTML=types.map(k=>`<button class="canva-button ${state.filter===k?"active":""}" type="button" data-filter="${k}" aria-pressed="${state.filter===k}">${t(k)}</button>`).join("");$("expense-subfilters").hidden=state.filter!=="expense";$("expense-subfilters").innerHTML=["all","fixed","variable"].map(k=>`<button class="canva-button ${state.subfilter===k?"active":""}" type="button" data-subfilter="${k}" aria-pressed="${state.subfilter===k}">${t(k)}</button>`).join("");$("copy-label").textContent=t("copy");$("bulk-label").textContent=state.bulk?t("cancel"):t("select");$("bulk-toggle").classList.toggle("active",state.bulk);let bar=$("selection-bar");if(state.bulk&&!bar){bar=document.createElement("div");bar.id="selection-bar";bar.className="selection-bar canva-banner";$("list-summary").before(bar)}if(bar)bar.hidden=!state.bulk;if(state.bulk)bar.innerHTML=`<span>${state.selected.size} ${t("selected")}</span><button type="button" data-select-all>${t("all")}</button><button type="button" class="danger" data-delete ${state.deleteArmed?"data-armed='true'":""} ${state.selected.size?"":"disabled"}>${t(state.deleteArmed?"confirmDelete":"delete")}</button>`;const rows=Finance.filtered(state.period,state.filter,state.subfilter);$("list-summary").textContent=`${rows.length} ${t("transactions")} · ${periodName(state.period)}`;$("entries-list").innerHTML=rows.length?rows.map(r=>transactionHTML(r,state.bulk)).join(""):`<div class="empty-state">${t("noEntries")}</div>`}
