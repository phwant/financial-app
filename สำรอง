  <script>
    /* DEMONSTRATION DATA ACCESS: replace this adapter when integrating with an existing application. */
    const DemoStore = (() => {
      const now = new Date(), currentKey = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,"0")}`;
      const previous = new Date(now.getFullYear(),now.getMonth()-1,1);
      const previousKey = `${previous.getFullYear()}-${String(previous.getMonth()+1).padStart(2,"0")}`;
      const templates = [
        ["Salary","เงินเดือน","income","other",48500,3,"briefcase-business"],
        ["Freelance project","งานฟรีแลนซ์","income","other",12400,9,"laptop"],
        ["Apartment rent","ค่าเช่าห้อง","expense","fixed",12500,2,"house"],
        ["Groceries","ซื้อของใช้","expense","variable",4280,6,"shopping-basket"],
        ["Dining out","ทานอาหารนอกบ้าน","expense","variable",2380,11,"utensils"],
        ["Transport","ค่าเดินทาง","expense","variable",1850,14,"train-front"],
        ["Subscriptions","ค่าสมาชิก","expense","fixed",790,17,"play"],
        ["Coffee","กาแฟ","expense","variable",540,20,"coffee"],
        ["Tax deduction","ลดหย่อนภาษี","deduction","other",3200,22,"file-check-2"]
      ];
      let nextId=1;
      const records=[];
      function seed(key,factor){templates.forEach(([en,th,type,subtype,amount,day,icon])=>records.push({id:nextId++,en,th,type,subtype,amount:Math.round(amount*factor),date:`${key}-${String(day).padStart(2,"0")}`,icon}));}
      seed(currentKey,1);seed(previousKey,.92);
      return {currentKey,records,all:()=>records,add:r=>{r.id=nextId++;records.push(r)},update:(id,changes)=>{const r=records.find(x=>x.id===id);if(r)Object.assign(r,changes)},remove:ids=>{for(let i=records.length-1;i>=0;i--)if(ids.includes(records[i].id))records.splice(i,1)}};
    })();

    /* BUSINESS LOGIC: pure period, filtering, and summary calculations. */
    const Finance = {
      key(date){return `${date.getFullYear()}-${String(date.getMonth()+1).padStart(2,"0")}`},
      offset(key,n){let [y,m]=key.split("-").map(Number);return this.key(new Date(y,m-1+n,1))},
      monthRecords(key){return DemoStore.all().filter(r=>r.date.slice(0,7)===key).sort((a,b)=>b.date.localeCompare(a.date)||b.id-a.id)},
      totals(key){const rows=this.monthRecords(key),sum=type=>rows.filter(r=>r.type===type).reduce((n,r)=>n+r.amount,0);const income=sum("income"),expense=sum("expense"),deduction=sum("deduction");return {income,expense,deduction,balance:income-expense-deduction,rate:income?((income-expense-deduction)/income)*100:0}},
      change(a,b){return b?((a-b)/Math.abs(b))*100:0},
      filtered(key,type,sub){return this.monthRecords(key).filter(r=>(type==="all"||r.type===type)&&(type!=="expense"||sub==="all"||r.subtype===sub))},
      spending(key){return this.monthRecords(key).filter(r=>r.type==="expense").sort((a,b)=>b.amount-a.amount)}
