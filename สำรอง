    function renderTables(){const keys=Array.from({length:4},(_,i)=>Finance.offset(state.period,-i));$("monthly-table").innerHTML=`<table class="data-table"><thead><tr><th>${t("month")}</th><th>${t("income")}</th><th>${t("expense")}</th><th>${t("balance")}</th><th>${t("change")}</th></tr></thead><tbody>${keys.map((k,i)=>{const a=Finance.totals(k),b=Finance.totals(Finance.offset(k,-1));return `<tr><td>${periodName(k,true)} ${k.slice(0,4)}</td><td>฿${money(a.income)}</td><td>฿${money(a.expense)}</td><td>฿${money(a.balance)}</td><td>${compareHTML(a.balance,b.balance)}</td></tr>`}).join("")}</tbody></table>`;const currentYear=Number(state.period.slice(0,4));$("annual-table").innerHTML=`<table class="data-table"><thead><tr><th>${t("year")}</th><th>${t("income")}</th><th>${t("expense")}</th><th>${t("deduction")}</th><th>${t("balance")}</th></tr></thead><tbody>${[currentYear,currentYear-1].map(year=>{const months=Array.from({length:12},(_,i)=>Finance.totals(`${year}-${String(i+1).padStart(2,"0")}`));return `<tr><td>${state.lang==="th"?year+543:year}</td>${["income","expense","deduction","balance"].map(k=>`<td>฿${money(months.reduce((n,m)=>n+m[k],0))}</td>`).join("")}</tr>`}).join("")}</tbody></table>`}
    function renderCharts(){if(state.screen!=="insights"||!window.Chart)return;const common={responsive:true,maintainAspectRatio:false,animation:{duration:350},plugins:{legend:{labels:{color:"#0B0D0E",boxWidth:9,boxHeight:9,font:{family:"Inter",size:10,weight:"600"}}},tooltip:{callbacks:{label:c=>`${c.dataset.label}: ฿${money(c.raw.y??c.raw)}`}}},scales:{x:{grid:{display:false},ticks:{color:"#0B0D0E",font:{family:"Inter",size:10}}},y:{beginAtZero:true,grid:{color:"rgba(86,112,76,.14)"},ticks:{color:"#0B0D0E",font:{family:"Inter",size:10},callback:v=>money(v,true)}}}};const bubbleKeys=Array.from({length:state.bubbleRange},(_,i)=>Finance.offset(state.period,i-state.bubbleRange+1));if(state.bubbleChart)state.bubbleChart.destroy();const bubbleData=[["income","#86ab80",0],["expense","#d4bc76",1],["deduction","#b6ca9a",2]].map(([type,color,index])=>({label:t(type),data:bubbleKeys.map((key,i)=>({x:i,y:Finance.totals(key)[type],r:Finance.totals(key)[type]?Math.max(5,Math.min(17,Math.sqrt(Finance.totals(key)[type])/14)):0})),backgroundColor:color,borderColor:"#0B0D0E",borderWidth:.6}));state.bubbleChart=new Chart($("bubble-chart"),{type:"bubble",data:{datasets:bubbleData},options:{...common,scales:{...common.scales,x:{...common.scales.x,min:-.5,max:bubbleKeys.length-.5,ticks:{...common.scales.x.ticks,stepSize:1,callback:v=>bubbleKeys[v]?periodName(bubbleKeys[v],true):""}}}}});const lineKeys=Array.from({length:state.lineRange},(_,i)=>Finance.offset(state.period,i-state.lineRange+1));if(state.lineChart)state.lineChart.destroy();state.lineChart=new Chart($("line-chart"),{type:"line",data:{labels:lineKeys.map(k=>periodName(k,true)),datasets:[{label:t("balance"),data:lineKeys.map(k=>Finance.totals(k).balance),borderColor:"#789b78",backgroundColor:"rgba(120,155,120,.14)",pointBackgroundColor:"#0B0D0E",pointBorderColor:"#0B0D0E",pointRadius:4,pointHoverRadius:6,borderWidth:2,tension:.28,fill:true}]},options:{...common,plugins:{...common.plugins,legend:{display:false}}}})}
    function render(){document.documentElement.lang=state.lang;$("page-title").textContent=t(state.screen);$("period-label").textContent=periodName(state.period);$("language-toggle").textContent=state.lang==="en"?"TH":"EN";$("balance-label").textContent=t("balance");$("highlights-title").textContent=t("highlights");$("see-all").innerHTML=`${t("seeAll")} ${icon("arrow-up-right")}`;$("summary-title").textContent=t("summary");$("bubble-title").textContent=t("bubble");$("line-title").textContent=t("yearly");$("monthly-table-title").textContent=t("monthlyTable");$("annual-table-title").textContent=t("annualTable");$("top-title").textContent=t("top");$("view-all-spending").innerHTML=`${t("viewAll")} ${icon("arrow-up-right")}`;document.querySelectorAll("[data-nav-label]").forEach(el=>el.textContent=t(el.dataset.navLabel));document.querySelectorAll(".screen").forEach(el=>el.hidden=el.id!==state.screen+"-screen");document.querySelectorAll("[data-screen]").forEach(el=>{const active=el.dataset.screen===state.screen;el.classList.toggle("active",active);if(active)el.setAttribute("aria-current","page");else el.removeAttribute("aria-current")});$("add-entry").hidden=state.screen==="insights";renderOverview();renderEntries();if(state.screen==="insights")renderInsights();icons()}
