    const state={screen:"overview",lang:"en",period:DemoStore.currentKey,filter:"all",subfilter:"all",bulk:false,selected:new Set(),bubbleRange:6,lineRange:12,bubbleChart:null,lineChart:null,deleteArmed:false};
